include ../../Makefile.Common

.DEFAULT_GOAL := test

.PHONY: bench
bench:
	$(GOTEST) -run '^$$' -bench '^BenchmarkMappingCache$$' -benchmem ./...

ENVTEST_K8S_VERSION ?= 1.34.x!
ENVTEST_SETUP_VERSION ?= release-0.22
ENVTEST := $(TOOLS_BIN_DIR)/setup-envtest
# setup-envtest usage: https://github.com/kubernetes-sigs/controller-runtime/blob/main/tools/setup-envtest/README.md

.PHONY: envtest-install
envtest-install: $(ENVTEST)
	$(ENVTEST) use $(ENVTEST_K8S_VERSION)

$(ENVTEST): $(TOOLS_BIN_DIR)
	GOBIN=$(TOOLS_BIN_DIR) $(GOCMD) install sigs.k8s.io/controller-runtime/tools/setup-envtest@$(ENVTEST_SETUP_VERSION)

.PHONY: integration-test-envtest
integration-test-envtest: envtest-install
	KUBEBUILDER_ASSETS="$$($(ENVTEST) use -p path $(ENVTEST_K8S_VERSION))" $(GOTEST) $(GOTEST_OPT) -run '^TestKubernetesCacheInvalidatesMappingAfterObjectUpdate$$' .

.PHONY: bench-kube
bench-kube: envtest-install
	KUBEBUILDER_ASSETS="$$($(ENVTEST) use -p path $(ENVTEST_K8S_VERSION))" $(GOTEST) -run '^$$' -bench '^BenchmarkKubernetesCacheMapping$$' -benchmem .

BENCH_REPORT ?= benchmark-report.md

.PHONY: bench-report
bench-report: envtest-install
	@set -euo pipefail; \
	fake_output=$$(mktemp); \
	kube_output=$$(mktemp); \
	trap 'rm -f "$$fake_output" "$$kube_output"' EXIT; \
	echo "Running fake-lookup benchmarks..."; \
	$(GOTEST) -run '^$$' -bench '^BenchmarkMappingCache$$' -benchmem ./... > "$$fake_output"; \
	echo "Running envtest benchmarks..."; \
	assets="$$($(ENVTEST) use -p path $(ENVTEST_K8S_VERSION))"; \
	KUBEBUILDER_ASSETS="$$assets" $(GOTEST) -run '^$$' -bench '^BenchmarkKubernetesCacheMapping$$' -benchmem . > "$$kube_output"; \
	{ \
		echo '# kubemappingprocessor benchmark report'; \
		echo; \
		echo 'Generated by `make bench-report`.'; \
		echo; \
		echo '## Real controller-runtime cache List: cached vs uncached'; \
		echo; \
		echo '| Dataset | Uncached ns/op | Cached ns/op | Speedup | Uncached B/op | Cached B/op | Uncached allocs/op | Cached allocs/op | Uncached lists/op | Cached lists/op |'; \
		echo '|---|---:|---:|---:|---:|---:|---:|---:|---:|---:|'; \
		awk '/^BenchmarkKubernetesCacheMapping\// { \
			name=$$1; sub(/-[0-9]+$$/, "", name); split(name, parts, "/"); dataset=parts[2]; mode=parts[4]; \
			for (i=3; i<=NF; i++) { if ($$i == "ns/op") ns=$$(i-1); if ($$i == "B/op") bytes=$$(i-1); if ($$i == "allocs/op") allocs=$$(i-1); if ($$i == "lists/op") lists=$$(i-1) } \
			value[dataset,mode,"ns"]=ns; value[dataset,mode,"bytes"]=bytes; value[dataset,mode,"allocs"]=allocs; value[dataset,mode,"lists"]=lists \
		} END { \
			for (d=1; d<=3; d++) { dataset="objects_" (d == 1 ? 1 : (d == 2 ? 1000 : 10000)); u=value[dataset,"uncached","ns"]; c=value[dataset,"cached","ns"]; \
				if (u != "" && c != "") printf "| %s | %s | %s | %.1fx | %s | %s | %s | %s | %s | %s |\n", dataset, u, c, u/c, value[dataset,"uncached","bytes"], value[dataset,"cached","bytes"], value[dataset,"uncached","allocs"], value[dataset,"cached","allocs"], value[dataset,"uncached","lists"], value[dataset,"cached","lists"] \
			} \
		}' "$$kube_output"; \
		echo; \
		echo '## Fake-lookup benchmark rows'; \
		echo; \
		echo 'These isolate mapping-cache overhead without Kubernetes cache List cost.'; \
		echo; \
		echo '```text'; \
		awk '/^BenchmarkMappingCache\// { print }' "$$fake_output"; \
		echo '```'; \
	} > "$(BENCH_REPORT)"; \
	cat "$(BENCH_REPORT)"

